# Credenciais e URLs do OpenPort CODEBA
# Copie este arquivo para ".env" e preencha os valores reais.

OPENPORT_URL=https://openportilheus.codeba.gov.br/openportcodeba/
OPENPORT_URL_INTRANET=http://10.30.180.41/openportcodeba/

OPENPORT_LOGIN=seu_usuario
OPENPORT_SENHA=sua_senha

# Caminho da planilha de paralisações (relativo à raiz do projeto)
PLANILHA=data/Paralisacoes_YANGTZE_QUANTUM_09-07-2026.xlsx

# Execução do navegador
# PRIMEIRO_PLANO=true: navegador visível, em destaque, com pausas para acompanhar
PRIMEIRO_PLANO=true
HEADLESS=false
# Tempo (ms) de espera padrão para elementos
TIMEOUT_MS=30000
# Atraso (ms) entre ações do Playwright (recomendado 300+ para acompanhar)
SLOW_MO_MS=300
# Pausa extra (ms) após cada preenchimento/acionamento para visualizar na tela
PAUSA_VISUAL_MS=500
# Segundos para manter o navegador aberto ao final (0 = aguarda Enter)
MANTER_ABERTO_SEG=120

# Rótulo da opção "Estadia" no formulário de paralisação (deixe vazio se não souber)
ESTADIA_LABEL=

# Código do operador no OpenPort (padrão: Intermarítima = 30002)
OPERADOR=30002
